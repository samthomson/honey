# WebSocket URL of the real backend relay
BACKEND_WS_URL=ws://localhost:8008

# HTTP URL of the real backend relay (for NIP-11 relay info)
BACKEND_HTTP_URL=http://localhost:8008

# Port to listen on
PORT=8080

# Optional: protect admin dashboard with a Bearer token
ADMIN_TOKEN=

# Where to store the SQLite database
DATA_DIR=./data
